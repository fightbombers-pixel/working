# ---- Reddit (необов'язково, без ключів працює через публічний .json, але з меншими лімітами)
# https://www.reddit.com/prefs/apps -> create app -> "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=niche-finder/0.1 by u/your_username

# ---- X (Twitter): або офіційний API, або Apify
X_BEARER_TOKEN=
# ---- Threads: або офіційний Threads API (дозвіл threads_keyword_search), або Apify
THREADS_ACCESS_TOKEN=

# ---- Apify (дешева альтернатива офіційним API X і Threads)
# ID актора — з URL на apify.com/store, формат username~actor-name
APIFY_TOKEN=
APIFY_X_ACTOR=
APIFY_THREADS_ACTOR=

# ---- Pinterest Trends (офіційний API v5, бізнес-акаунт)
PINTEREST_ACCESS_TOKEN=
# Порожньо = US,CA,GB+IE,DE+AT+CH,FR,BR,AU+NZ
PINTEREST_REGIONS=

# ---- Claude API для аналізу болів
ANTHROPIC_API_KEY=

# ---- Проксі: через кому, або шлях до файлу (один на рядок). Формат: http://user:pass@host:port
PROXY_URLS=
PROXY_FILE=

# ---- Країни для Google Trends RSS
TRENDS_GEOS=US,GB,CA,AU,DE,FR,IN,BR,JP
