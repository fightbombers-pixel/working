# ---- Reddit (необов'язково, без ключів працює через публічний .json, але з меншими лімітами)
# https://www.reddit.com/prefs/apps -> create app -> "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=niche-finder/0.1 by u/your_username

# ---- Apify: ОДИН токен на Reddit, X, Threads, Pinterest (apify.com -> Settings -> API & Integrations)
APIFY_TOKEN=
# Необов'язково — замінити актори за замовчуванням
APIFY_REDDIT_ACTOR=
APIFY_X_ACTOR=
APIFY_THREADS_ACTOR=
APIFY_PINTEREST_ACTOR=

# ---- Офіційні API (необов'язково; якщо задані — мають пріоритет над Apify)
X_BEARER_TOKEN=
THREADS_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=
# Порожньо = US,GB+IE,CA,DE,FR,BR,AU+NZ,IN (коди ринків Pinterest)
PINTEREST_REGIONS=

# ---- Claude API для автоматичного аналізу (необов'язково, якщо аналізуєте в чаті)
ANTHROPIC_API_KEY=

# ---- Проксі: через кому, або шлях до файлу (один на рядок). Формат: http://user:pass@host:port
PROXY_URLS=
PROXY_FILE=

# ---- Країни для Google Trends RSS
TRENDS_GEOS=US,GB,CA,AU,DE,FR,IN,BR,JP
